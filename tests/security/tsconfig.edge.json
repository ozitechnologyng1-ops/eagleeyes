{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": { "npm:@supabase/supabase-js@2": ["../../node_modules/@supabase/supabase-js"] }
  },
  "include": [
    "edge-runtime.d.ts",
    "../../supabase/functions/_shared/*.ts",
    "../../supabase/functions/agent-auth/*.ts",
    "../../supabase/functions/agent-admin/*.ts",
    "../../supabase/functions/agent-sms/*.ts",
    "../../supabase/functions/analyze-result/*.ts",
    "../../supabase/functions/paystack/*.ts"
  ]
}

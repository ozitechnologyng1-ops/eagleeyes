# ==============================================================================
# FRONTEND / CLIENT ENVIRONMENT VARIABLES (Vite & Vercel)
# ==============================================================================
# These variables are bundled into the frontend by Vite at build time.
# Set these in your local .env.local AND in your Vercel Project Environment Variables.

# Public Supabase Project URL
VITE_SUPABASE_URL=https://wetkmmfvmabfqseiiysk.supabase.co

# Public Supabase Anon (Publishable) Key - Protected by PostgreSQL Row Level Security (RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google AI Gemini API Key (Used client-side for Live Result Sheet OCR Scanner)
VITE_GOOGLE_AI_KEY=AIzaSy...

# ==============================================================================
# BACKEND / SERVER SECRETS (Supabase Edge Functions ONLY)
# DO NOT PREFIX WITH VITE_ - NEVER EXPOSE IN CLIENT BUNDLES OR VERCEL CLIENT ENV
# ==============================================================================
# Configure these securely in Supabase Dashboard (Settings -> Edge Functions -> Secrets)
# or via Supabase CLI (`npx supabase secrets set KEY=VALUE`).

# Paystack Live Secret Key (Used exclusively by `paystack` edge function for payouts/transfers)
# PAYSTACK_SECRET_KEY=sk_live_...

# Groq Cloud API Key (Used by `whatsapp-group-webhook` and `whatsapp-admin` edge functions)
# GROQ_API_KEY=gsk_...

# Supabase Service Role Key (Admin edge function database access)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1Ni...
